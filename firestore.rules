rules_version = '2';

// Yala-Gam3ya: the browser NEVER reads or writes Firestore directly.
// All access goes through the Next.js server (Firebase Admin SDK), which
// enforces roles, approval, Gam3ya membership and audit logging
// (src/lib/data/policy.ts). Admin SDK bypasses these rules by design.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
